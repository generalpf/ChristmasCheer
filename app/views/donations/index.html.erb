<h1>
  <% if @donor %>
    Donations for <%= donor_display_name(@donor) %>
  <% else %>
    Donations
  <% end %>
</h1>

<p>
  <%= link_to "Back to menu", root_path %>
  <% if @donor %>
    | <%= link_to "Back to donor", donor_path(@donor) %>
  <% end %>
</p>

<%= form_with url: (@donor ? donor_donations_path(@donor) : donations_path),
              method: :get, local: true, class: "donations-filter" do |f| %>
  <%= f.label :year %>
  <%= f.select :year,
        options_for_select(@available_years.map { |y| [ y.to_s, y.to_s ] }, @year&.to_s),
        { include_blank: "Any year" } %>

  <% if @donor.nil? %>
    <%= f.label :q, "Search donor name or company" %>
    <%= f.search_field :q, value: @q %>
  <% end %>

  <%= f.submit "Filter" %>
  <% if @year || @q.present? %>
    <%= link_to "Clear", (@donor ? donor_donations_path(@donor) : donations_path) %>
  <% end %>
<% end %>

<p>
  <% if @donor %>
    <%= link_to "Record a new donation", new_donor_donation_path(@donor) %>
  <% else %>
    <%= link_to "Record a new donation", new_donation_path %>
  <% end %>
</p>

<% if @donations.empty? %>
  <p>No donations found.</p>
<% else %>
  <table class="donations-list">
    <thead>
      <tr>
        <th>Date</th>
        <th>Amount</th>
        <% if @donor.nil? %>
          <th>Donor</th>
        <% end %>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @donations.each do |donation| %>
        <tr>
          <td><%= donation.donation_date %></td>
          <td><%= number_to_currency(donation.amount, unit: "$") %></td>
          <% if @donor.nil? %>
            <td><%= link_to donor_display_name(donation.donor), donor_path(donation.donor) %></td>
          <% end %>
          <td><%= link_to "View", donation_path(donation) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>

<nav class="donations-pagination" aria-label="Donation pages">
  <% nav_args = { year: @year, q: @q.presence } %>
  <% if @page > 1 %>
    <%= link_to "Previous",
          (@donor ? donor_donations_path(@donor, **nav_args, page: @page - 1) : donations_path(**nav_args, page: @page - 1)),
          rel: "prev" %>
  <% else %>
    <span class="disabled">Previous</span>
  <% end %>
  <span>Page <%= @page %> of <%= @total_pages %></span>
  <% if @page < @total_pages %>
    <%= link_to "Next",
          (@donor ? donor_donations_path(@donor, **nav_args, page: @page + 1) : donations_path(**nav_args, page: @page + 1)),
          rel: "next" %>
  <% else %>
    <span class="disabled">Next</span>
  <% end %>
</nav>
