<h1>New donation<%= " for #{donor_display_name(@donor)}" if @donor %></h1>

<% if @donor %>
  <%= render "form", donation: @donation,
        form_url: donor_donations_path(@donor),
        show_donor_select: false %>
<% else %>
  <%= render "form", donation: @donation,
        form_url: donations_path,
        show_donor_select: true %>
<% end %>

<p>
  <%= link_to "Back to donations", donations_path %>
  <% if @donor %>
    | <%= link_to "Back to donor", donor_path(@donor) %>
  <% end %>
</p>
